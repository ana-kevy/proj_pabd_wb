(
    tipo_rito integer NOT NULL GENERATED ALWAYS AS IDENTITY ( INCREMENT 1 START 1 MINVALUE 1 MAXVALUE 2147483647 CACHE 1 ),
    rito_funerario character varying(10) COLLATE pg_catalog."default" NOT NULL,
    preco integer NOT NULL,
    CONSTRAINT ritos_pkey PRIMARY KEY (tipo_rito)
)

