CREATE TABLE IF NOT EXISTS public.plano
(
    plano_id integer NOT NULL GENERATED ALWAYS AS IDENTITY ( INCREMENT 6 START 1 MINVALUE 1 MAXVALUE 2147483647 CACHE 1 ),
    user_id integer NOT NULL,
    tipo_rito integer NOT NULL,
    CONSTRAINT plano_pkey PRIMARY KEY (plano_id),
    CONSTRAINT plano_tipo_rito_fkey FOREIGN KEY (tipo_rito)
        REFERENCES public.ritos (tipo_rito) MATCH SIMPLE
        ON UPDATE NO ACTION
        ON DELETE NO ACTION,
    CONSTRAINT plano_user_id_fkey FOREIGN KEY (user_id)
        REFERENCES public.cadastro (user_id) MATCH SIMPLE
        ON UPDATE NO ACTION
        ON DELETE NO ACTION
)

TABLESPACE pg_default;

ALTER TABLE IF EXISTS public.plano
    OWNER to postgres;

