CREATE TABLE IF NOT EXISTS public.detalhes_cremacao
(
    id_cremacao integer NOT NULL GENERATED ALWAYS AS IDENTITY ( INCREMENT 2 START 1 MINVALUE 1 MAXVALUE 2147483647 CACHE 1 ),
    cor_das_cinzas character varying(10) COLLATE pg_catalog."default" NOT NULL,
    material_pote character varying(20) COLLATE pg_catalog."default" NOT NULL,
    estilo_pote character varying(20) COLLATE pg_catalog."default" NOT NULL,
    cor_do_pote character varying(20) COLLATE pg_catalog."default" NOT NULL,
    plano_id integer NOT NULL,
    CONSTRAINT detalhes_cremacao_pkey PRIMARY KEY (id_cremacao),
    CONSTRAINT detalhes_cremacao_plano_id_fkey FOREIGN KEY (plano_id)
        REFERENCES public.plano (plano_id) MATCH SIMPLE
        ON UPDATE NO ACTION
        ON DELETE NO ACTION
)

TABLESPACE pg_default;

ALTER TABLE IF EXISTS public.detalhes_cremacao
    OWNER to postgres;

